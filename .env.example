# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.

# Public URL of the site (used for metadata and absolute URLs)
NEXT_PUBLIC_SITE_URL=https://kitsap.work

# Where quote requests are delivered
CONTACT_EMAIL=

# Sender address, e.g. KITSAP <hello@kitsap.work>
# Must be on a domain verified in Resend.
EMAIL_FROM=

# Resend API key (server-side only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=

# Set to true to also email the sender a short "we received your request" note
SEND_CONFIRMATION_EMAIL=false
